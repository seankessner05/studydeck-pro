{
  "name": "studydeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cited chat over my own class notes, powered by the Claude Code CLI",
  "scripts": {
    "css": "tailwindcss -i public/input.css -o public/app.css --minify",
    "build": "npm run css",
    "dev": "npm run css && tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "npm run css && tsx --disable-warning=ExperimentalWarning src/server.ts",
    "sync": "tsx --disable-warning=ExperimentalWarning src/sync-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx --disable-warning=ExperimentalWarning src/eval/run.ts",
    "doctor": "tsx --disable-warning=ExperimentalWarning src/doctor-cli.ts",
    "eval:cards": "tsx --disable-warning=ExperimentalWarning src/eval/cards.ts",
    "eval:quiz": "tsx --disable-warning=ExperimentalWarning src/eval/quiz.ts",
    "eval:problems": "tsx --disable-warning=ExperimentalWarning src/eval/problems.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "mathjs": "^15.2.0",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
